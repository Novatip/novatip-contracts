# Copy to .env and fill in. Used by scripts/*.sh.

# testnet | mainnet | local
NETWORK=testnet

# Name of a configured Stellar CLI identity (the source/signing account).
# Create one with: stellar keys generate my-identity --network testnet
SOURCE=my-identity

# Admin address stored in the contract at deploy time (G... account or C... contract).
ADMIN=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract id (C...) for the chosen network.
#   testnet:  CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
#   mainnet:  CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
USDC_TOKEN=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/create-jar.sh, update-splits.sh and jar-info.sh ---
# Contract id to operate on. Optional: falls back to .contract-id.<NETWORK>
# written by scripts/deploy.sh (e.g. .contract-id.testnet).
# CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OWNER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLUG=@alice

# Single-recipient shorthand — builds a 100% split. Ignored if SPLITS is set.
RECIPIENT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Full splits JSON for multi-recipient jars (optional; overrides RECIPIENT).
# bps values must sum to 10000; at most 20 recipients.
# SPLITS=[{"to":"GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX","bps":6000},{"to":"GYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY","bps":4000}]

# --- For scripts/transfer-jar.sh ---
# Address taking control of the jar. SOURCE must be the jar's *current* owner,
# since only the owner authorizes the transfer; the new owner signs nothing.
NEW_OWNER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/set-min-tip.sh ---
# Minimum tip amount in the token's smallest unit (USDC: 1000000 == 1 USDC).
# Zero and negative values are rejected before any network call.
# Unset it, or set it to "none", to clear the minimum (the contract then accepts
# any positive tip again) — clearing is the same as `MIN_TIP=` here, not 0.
MIN_TIP=5000000

# --- For scripts/set-fee.sh ---
# Protocol fee in basis points, 0..=500 (5% cap). SOURCE must be the contract
# admin. The contract defaults to 0; 100 (1%) is the intended configured value.
FEE_BPS=100

# --- For scripts/set-hook.sh ---
# Optional post-tip hook contract address (C...). Unset, empty, or "none" clears it.
# HOOK=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/set-registrar.sh ---
# Optional jar registrar address (G... or C...). Unset, empty, or "none" clears it.
# REGISTRAR=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/tip.sh ---
# Optional 32-byte reference (64 hex chars, calls tip_with_ref) or allowlisted token (C..., calls tip_in_token).
# REFERENCE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# TOKEN=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/pause-jar.sh ---
# Set PAUSED=true to stop tips or false to resume them. SOURCE must own the jar.
PAUSED=true

# --- For scripts/lock-splits.sh ---
# ACTION=lock submits directly as the owner. ACTION=unlock prints the required
# owner and recipient multisigner instructions; it does not submit by itself.
ACTION=lock

# --- For scripts/allowlist.sh ---
# ACTION=allow|disallow|check and TOKEN is the C... asset to change or inspect.
# ACTION is shared with the other scripts above; set it per invocation.
# TOKEN=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/pause-contract.sh ---
# ACTION=pause|resume|status. SOURCE must be the contract admin.
# ACTION=pause

# --- For scripts/withdraw-held.sh ---
# RECIPIENT is the G... account whose escrowed share is withdrawn. USDC_TOKEN
# (above) is reused for the trustline check.
# RECIPIENT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/transfer-admin.sh ---
# NEW_ADMIN is a G... account that must already exist on NETWORK, or a
# configured CLI identity name. The typed confirmation can be skipped with
# YES=1 when running non-interactively.
# NEW_ADMIN=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# YES=1

# --- For scripts/trustline.sh ---
# Space-separated CLI identity names and/or G... addresses that need a USDC
# trustline before they can tip or receive tips. With SLUG set too, the jar's
# recipients are checked as well.
IDENTITIES=my-identity

# --- For scripts/events.sh ---
# EVENT=tip            # jar_crtd | splits | jar_xfer | min_tip | tip | all (default)
# START_LEDGER=        # default: WINDOW ledgers back from the current ledger
# WINDOW=10000

# --- For scripts/rename-jar.sh ---
# Canonical slug (3-32 lowercase letters, digits, '_' or '-') to rename SLUG to.
# NEW_SLUG=@alice-new

# --- For scripts/delete-jar.sh ---
# YES=1 skips the typed slug confirmation in automation. The jar's config and
# totals are printed either way, and jar_exists is read back after deletion.
# YES=1

# --- For scripts/recurring.sh ---
# Schedule id used by the show, cancel and collect subcommands.
# ID=1
# create: jar, amount per period (smallest token unit), period in ledgers and
# an optional message (default: "recurring tip", max 280 UTF-8 bytes).
# SLUG=@alice
# AMOUNT=1000000
# PERIOD_LEDGERS=17280
# MESSAGE=thanks for the coffee
# SUPPORTER defaults to SOURCE's address; create requires that identity to sign.
# SUPPORTER=my-identity
# The printed approve command covers APPROVE_AMOUNT (default: AMOUNT) and
# expires at EXPIRATION_LEDGER (default: current ledger + 100000).
# APPROVE_AMOUNT=1000000
# EXPIRATION_LEDGER=12345678

# --- For scripts/upgrade.sh ---
# Prebuilt wasm to upload. Unset to build this checkout with
# `stellar contract build --optimize` and locate the artifact under target/.
# WASM=target/wasm32v1-none/release/tip_splitter.wasm
# CONFIRM_MAINNET=1 skips the typed mainnet upgrade confirmation (CI only).
# CONFIRM_MAINNET=1
